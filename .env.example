# UI-Pro Environment Configuration
# Copy to .env (gitignored) and edit. Everything below the LLM URL is optional.
# ⚠️ NEVER commit this file with real tokens!

# ─── 1. Your LLM backend — REQUIRED, uncomment ONE ──────────────────────
# Local dev (no Docker): use localhost
OLLAMA_URL=http://localhost:11434
# LM Studio / Ollama running on your host machine (from inside Docker compose):
# OLLAMA_URL=http://host.docker.internal:11434
# LMSTUDIO_URL=http://host.docker.internal:1234

# ─── 2. Models — optional, auto-discovered from your backend ─────────────
# Pin specific models if you want deterministic behavior:
MODEL_FAST=qwen2.5-coder:7b
MODEL_REASONING=qwen2.5-coder:32b

# ─── 3. API key — optional for local use (leave empty) ──────────────────
API_KEY=

# HF_TOKEN: Hugging Face token for embedding model download (memory feature)
HF_TOKEN=your_huggingface_token_here

# ─── Timeouts ────────────────────────────────────────────────────────────
# LLM_TIMEOUT: Timeout in seconds for LLM API calls.
# Keep >= 120s for local models on mid-range GPUs (first request loads VRAM).
LLM_TIMEOUT=900
EXECUTOR_TIMEOUT=60

# ─── Advanced (Hermes MCP server, port 8001) ─────────────────────────────
# HERMES_LLM_BASE_URL: LM Studio / OpenAI-compatible endpoint
# HERMES_LLM_BASE_URL=http://localhost:1234/v1
# HERMES_LLM_API_KEY: API key for the LLM endpoint
# HERMES_LLM_API_KEY=lm-studio
# HERMES_LLM_MODEL: Default model for Hermes chat
# HERMES_LLM_MODEL=google/gemma-4-12b-qat
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
